#include <iostream>
using namespace std;

class Student {
public:
    string name;

    Student(string n, int i) {
        name = n;
        id = i;
    }

    int getId() {
        return id;
    }

private:
    int id;
};

int main() {
    Student student("Alice", 12345);

    student.name = "Bob";

    cout << "Name: " << student.name << "\n";
    cout << "ID: " << student.getId() << "\n";

    return 0;
}
